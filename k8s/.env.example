# Template for the app-secrets Kubernetes secret. Copy to k8s/.env (git-ignored) and fill in real values:
#   kubectl -n webgenai-core create secret generic app-secrets --from-env-file=k8s/.env
#   kubectl -n webgenai-previews create secret generic app-secrets --from-env-file=k8s/.env

# Postgres superuser
POSTGRES_PASSWORD=yourpostgrespassword

# Per-database passwords
ACCOUNT_DB_PASSWORD=youraccountdbpassword
WORKSPACE_DB_PASSWORD=yourworkspacedbpassword
INTELLIGENCE_DB_PASSWORD=yourintelligencedbpassword

JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

MINIO_ROOT_PASSWORD=yourminionpassword
MINIO_ROOT_USER=minio

ANTHROPIC_API_KEY=youranthropicapikey

# Only needed when AI_PROVIDER=openai
AI_API_KEY=aiapikey

STRIPE_API_KEY=testapikey
STRIPE_WEBHOOK_SECRET=testwebhooksecret

GIT_USERNAME=sagardevlab
GIT_PASSWORD=yourgitpassword